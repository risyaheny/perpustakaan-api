    {
      "name": "01 GET Daftar Buku (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Response is an array of books', function () {",
              "    const data = pm.response.json();",
              "    pm.expect(data).to.be.an('array');",
              "    pm.expect(data.length).to.be.at.least(2);",
              "    pm.expect(data[0]).to.have.property('title');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/books",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "books"
          ]
        },
        "description": "Ambil seluruh daftar buku. Data awal berisi buku id 1 dan id 2."
      },
      "response": []
    },
