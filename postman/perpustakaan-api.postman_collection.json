        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Buku Newman (PATCH)\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/books/{{book_id}}",
          "host": ["{{base_url}}"],
          "path": ["books", "{{book_id}}"]
        }
      }
    },
    {
      "name": "6. POST /books/bulk 2 buku ISBN acak -> 201",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var ts = Date.now();",
              "pm.collectionVariables.set('bulkIsbn1', '978-bulk1-' + ts + '-' + Math.floor(Math.random() * 100000));",
              "pm.collectionVariables.set('bulkIsbn2', '978-bulk2-' + ts + '-' + Math.floor(Math.random() * 100000));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 201 Created', function () {",
              "  pm.response.to.have.status(201);",
              "});",
              "pm.test('response array berisi 2 buku tersimpan', function () {",
              "  var json = pm.response.json();",
              "  pm.expect(json).to.be.an('array').with.lengthOf(2);",
              "  pm.expect(json[0]).to.have.property('id');",
              "  pm.expect(json[1]).to.have.property('id');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "[\n  {\n    \"title\": \"Buku Bulk 1\",\n    \"author\": \"A\",\n    \"isbn\": \"{{bulkIsbn1}}\"\n  },\n  {\n    \"title\": \"Buku Bulk 2\",\n    \"author\": \"B\",\n    \"isbn\": \"{{bulkIsbn2}}\",\n    \"year\": 2024,\n    \"stock\": 2,\n    \"available\": 2\n  }\n]"
        },
        "url": {
          "raw": "{{base_url}}/books/bulk",
          "host": ["{{base_url}}"],
          "path": ["books", "bulk"]
        }
      }
    },
    {
      "name": "7. POST /books title kosong -> 400",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 400 Bad Request', function () {",
              "  pm.response.to.have.status(400);",
              "});",
              "pm.test('format error seragam', function () {",
              "  var json = pm.response.json();",
              "  pm.expect(json.statusCode).to.eql(400);",
              "  pm.expect(json).to.have.property('error');",
              "  pm.expect(json).to.have.property('message');",
              "  pm.expect(json).to.have.property('path', '/books');",
              "  pm.expect(json).to.have.property('timestamp');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"\",\n  \"author\": \"Penulis\",\n  \"isbn\": \"978-invalid-title\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/books",
          "host": ["{{base_url}}"],
          "path": ["books"]
        }
      }
    },
