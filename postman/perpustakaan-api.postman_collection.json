{
  "info": {
    "_postman_id": "b7e5a1c2-7d4f-4b8e-9c3a-1f2e3d4c5b6a",
    "name": "Tugas 7 - Newman",
    "description": "Pengujian endpoint perpustakaan-api (books). ISBN acak via pre-request; id/ISBN disimpan ke variable collection agar bisa dijalankan berulang.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:3000" },
    { "key": "book_id", "value": "" },
    { "key": "isbn1", "value": "" },
    { "key": "bulkIsbn1", "value": "" },
    { "key": "bulkIsbn2", "value": "" },
    { "key": "bulkNewIsbn", "value": "" }
  ],
  "item": [
    {
      "name": "1. POST /books valid -> 201 (simpan id)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('isbn1', '978-' + Date.now() + '-' + Math.floor(Math.random() * 100000));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 201 Created', function () {",
              "  pm.response.to.have.status(201);",
              "});",
              "pm.test('response berisi id dan isbn sesuai request', function () {",
              "  var json = pm.response.json();",
              "  pm.expect(json).to.have.property('id');",
              "  pm.expect(json.id).to.be.a('number');",
              "  pm.expect(json.isbn).to.eql(pm.collectionVariables.get('isbn1'));",
              "  pm.expect(json.title).to.eql('Buku Newman');",
              "  pm.collectionVariables.set('book_id', json.id);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Buku Newman\",\n  \"author\": \"Penguji\",\n  \"isbn\": \"{{isbn1}}\",\n  \"year\": 2024,\n  \"category\": \"Uji\",\n  \"stock\": 5,\n  \"available\": 5\n}"
        },
        "url": {
          "raw": "{{base_url}}/books",
          "host": ["{{base_url}}"],
          "path": ["books"]
        }
      }
    },
    {
      "name": "2. GET /books -> 200, array",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200 OK', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test('response berupa array', function () {",
              "  var json = pm.response.json();",
              "  pm.expect(json).to.be.an('array');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/books",
          "host": ["{{base_url}}"],
          "path": ["books"]
        }
      }
    },
    {
      "name": "3. GET /books/{id} -> 200",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200 OK', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test('response adalah buku dengan id yang diminta', function () {",
              "  var json = pm.response.json();",
              "  pm.expect(json.id).to.eql(Number(pm.collectionVariables.get('book_id')));",
              "  pm.expect(json).to.have.property('title');",
              "  pm.expect(json).to.have.property('isbn');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/books/{{book_id}}",
          "host": ["{{base_url}}"],
          "path": ["books", "{{book_id}}"]
        }
      }
    },
    {
      "name": "4. PUT /books/{id} -> 200",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200 OK', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "pm.test('data terganti seluruhnya', function () {",
              "  var json = pm.response.json();",
              "  pm.expect(json.id).to.eql(Number(pm.collectionVariables.get('book_id')));",
              "  pm.expect(json.title).to.eql('Buku Newman (PUT)');",
              "  pm.expect(json.author).to.eql('Penguji PUT');",
              "  pm.expect(json.isbn).to.eql(pm.collectionVariables.get('isbn1'));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Buku Newman (PUT)\",\n  \"author\": \"Penguji PUT\",\n  \"isbn\": \"{{isbn1}}\",\n  \"year\": 2025,\n  \"category\": \"Uji\",\n  \"stock\": 10,\n  \"available\": 10\n}"
        },
        "url": {
          "raw": "{{base_url}}/books/{{book_id}}",
          "host": ["{{base_url}}"],
          "path": ["books", "{{book_id}}"]
        }
      }
    },
    {
      "name": "5. PATCH /books/{id} -> 200",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200 OK', function () {",
              "  pm.response.to.have.status(200);",
