        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "[\n  {\n    \"title\": \"Bulk Baru (akan rollback)\",\n    \"author\": \"C\",\n    \"isbn\": \"{{bulkNewIsbn}}\"\n  },\n  {\n    \"title\": \"Bulk Duplikat\",\n    \"author\": \"D\",\n    \"isbn\": \"{{isbn1}}\"\n  }\n]"
        },
