    {
      "name": "10. POST /books ISBN sama dengan request 1 -> 409",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 409 Conflict', function () {",
              "  pm.response.to.have.status(409);",
              "});",
              "pm.test('pesan konflik ISBN', function () {",
              "  var json = pm.response.json();",
              "  pm.expect(json.statusCode).to.eql(409);",
              "  pm.expect(json.error).to.eql('Conflict');",
              "  pm.expect(json.message).to.include('ISBN');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Duplikat ISBN\",\n  \"author\": \"Penguji\",\n  \"isbn\": \"{{isbn1}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/books",
          "host": ["{{base_url}}"],
          "path": ["books"]
        }
      }
    },
    {
      "name": "11. POST /books/bulk ISBN baru + duplikat -> 409",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('bulkNewIsbn', '978-bulknew-' + Date.now() + '-' + Math.floor(Math.random() * 100000));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 409 Conflict (rollback batch)', function () {",
              "  pm.response.to.have.status(409);",
              "});",
              "pm.test('body error konflik', function () {",
              "  var json = pm.response.json();",
              "  pm.expect(json.statusCode).to.eql(409);",
              "  pm.expect(json.error).to.eql('Conflict');",
              "});"
            ]
          }
        }
      ],
