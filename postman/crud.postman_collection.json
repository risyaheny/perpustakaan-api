              "    pm.expect(data.title).to.eql('Pemrograman Algoritma dan Struktur Data (Edisi Revisi)');",
              "    pm.expect(data.year).to.eql(2022);",
              "    pm.expect(data.stock).to.eql(8);",
              "});"
            ]
          }
        }
      ],
