        "description": "Ambil detail buku berdasarkan id (buku seed pertama)."
      }
    },
    {
      "name": "03 POST Tambah Buku (201)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 201', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test('Buku baru berhasil dibuat', function () {",
              "    const data = pm.response.json();",
              "    pm.expect(data).to.have.property('id');",
              "    pm.expect(data.title).to.eql('Pemrograman Web Lanjut');",
              "    pm.expect(data.isbn).to.eql('978-602-777-101-4');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Pemrograman Web Lanjut\",\n  \"author\": \"Sari Dewi\",\n  \"isbn\": \"978-602-777-101-4\",\n  \"year\": 2024,\n  \"category\": \"Informatika\",\n  \"stock\": 6,\n  \"available\": 6\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/books",
          "host": ["{{base_url}}"],
          "path": ["books"]
        },
        "description": "Tambah buku baru (CreateBookDto: title wajib, sisanya opsional). ISBN 978-602-777-101-4 belum dipakai di seed."
      }
    },
    {
      "name": "04 PUT Ganti Buku (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
