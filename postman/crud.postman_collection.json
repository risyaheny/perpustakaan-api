              "});",
              "pm.test('NotFound exception dari service', function () {",
              "    pm.expect(pm.response.json().statusCode).to.eql(404);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/books/999",
          "host": ["{{base_url}}"],
          "path": ["books", "999"]
        },
        "description": "Buku id 999 tidak ada -> service melempar NotFoundException -> 404."
      }
    },
    {
      "name": "08 POST Data Tidak Valid (400)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 400', function () {",
              "    pm.response.to.have.status(400);",
              "});",
              "pm.test('Validasi menolak body tanpa title', function () {",
              "    const data = pm.response.json();",
              "    pm.expect(data.statusCode).to.eql(400);",
              "    pm.expect(data.message).to.be.an('array').that.includes('title wajib diisi');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
