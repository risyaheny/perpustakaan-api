          "raw": "{\n  \"author\": \"Penulis Tanpa Judul\",\n  \"year\": 2024\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/books",
          "host": ["{{base_url}}"],
          "path": ["books"]
        },
        "description": "Body tanpa title -> ValidationPipe global menolak (400), message 'title wajib diisi'."
