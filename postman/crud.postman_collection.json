    "name": "Tugas 5 - CRUD NestJS Perpustakaan",
    "description": "Collection untuk menguji endpoint CRUD modul books NestJS. Jalankan server dulu dengan `npm run start:dev`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000"
    }
  ],
  "item": [
    {
      "name": "01 GET Daftar Buku (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Response is an array of books', function () {",
              "    const data = pm.response.json();",
              "    pm.expect(data).to.be.an('array');",
              "    pm.expect(data.length).to.be.at.least(2);",
              "    pm.expect(data[0]).to.have.property('title');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/books",
          "host": ["{{base_url}}"],
          "path": ["books"]
        },
        "description": "Ambil seluruh daftar buku. Data awal berisi buku id 1 dan id 2."
      }
    },
    {
      "name": "02 GET Detail Buku (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Detail buku id 1', function () {",
              "    const data = pm.response.json();",
              "    pm.expect(data.id).to.eql(1);",
              "    pm.expect(data).to.have.property('title');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/books/1",
          "host": ["{{base_url}}"],
          "path": ["books", "1"]
