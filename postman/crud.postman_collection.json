          "raw": "{\n  \"title\": \"Pemrograman Algoritma dan Struktur Data (Edisi Revisi)\",\n  \"author\": \"Budi Santoso\",\n  \"isbn\": \"978-602-123-456-7\",\n  \"year\": 2022,\n  \"category\": \"Informatika\",\n  \"stock\": 8,\n  \"available\": 5\n}",
